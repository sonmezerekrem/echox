{
  "name": "@sonmezerekrem/echox",
  "version": "1.12.0",
  "type": "module",
  "description": "Static documentation site builder powered by Astro",
  "license": "GPL-3.0-or-later",
  "bin": {
    "echox": "./bin/echox.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sonmezerekrem/echox.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ECHOX_DIR=./docs astro dev",
    "build": "ECHOX_DIR=./docs astro build && pagefind --site ./docs/dist",
    "preview": "ECHOX_DIR=./docs astro preview",
    "publish:npm": "npm publish --registry https://registry.npmjs.org/ --access public"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.0.0",
    "@shikijs/transformers": "^4.3.1",
    "astro": "^7.1.3",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "remark-directive": "^4.0.0",
    "unist-util-visit": "^5.0.0",
    "vite": "^8.1.5",
    "yaml": "^2.9.0"
  }
}
